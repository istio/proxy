+        "@envoy_api//envoy/extensions/upstreams/http/v3:pkg_cc_proto",
+    ] + envoy_select_enable_http3([
+        "//source/common/quic:quic_client_factory_lib",
+        "//source/extensions/upstreams/http:config",
