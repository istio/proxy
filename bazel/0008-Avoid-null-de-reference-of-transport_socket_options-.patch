From f7c0fff28a356d63409c3374843288ae25c9071a Mon Sep 17 00:00:00 2001
From: Yan Avlasov <yavlasov@google.com>
Date: Tue, 28 Jul 2026 13:21:15 +0000
Subject: [PATCH 08/13] Avoid null de-reference of transport_socket_options for
 HTTP/3

Fixes CVE-2026-48521 https://github.com/envoyproxy/envoy/security/advisories/GHSA-5vff-j9p4-38j3

Signed-off-by: Yan Avlasov <yavlasov@google.com>
Signed-off-by: Ethan Truong <ethantruong@google.com>
Signed-off-by: Kateryna Nezdolii <kateryna.nezdolii@gmail.com>
---
 .../http3__fixed-crash-due-to-null-deref.rst  |  4 +
 .../common/upstream/cluster_manager_impl.cc   |  2 +-
 test/integration/BUILD                        | 18 ++++
 .../allocate_conn_pool_integration_test.cc    | 85 +++++++++++++++++++
 4 files changed, 108 insertions(+), 1 deletion(-)
 create mode 100644 changelogs/current/bug_fixes/http3__fixed-crash-due-to-null-deref.rst
 create mode 100644 test/integration/allocate_conn_pool_integration_test.cc

diff --git a/changelogs/current/bug_fixes/http3__fixed-crash-due-to-null-deref.rst b/changelogs/current/bug_fixes/http3__fixed-crash-due-to-null-deref.rst
new file mode 100644
index 0000000000..d86b7187d5
--- /dev/null
+++ b/changelogs/current/bug_fixes/http3__fixed-crash-due-to-null-deref.rst
@@ -0,0 +1,4 @@
+Fix: `CVE-2026-48521 <https://github.com/envoyproxy/envoy/security/advisories/GHSA-5vff-j9p4-38j3>`_
+
+Fixed abnormal process termination when Envoy is configured to automatically select a protocol with upstream
+server based on ALPN and the server uses HTTP/3.
diff --git a/source/common/upstream/cluster_manager_impl.cc b/source/common/upstream/cluster_manager_impl.cc
index 23676d4eb8..f01fe69ecd 100644
--- a/source/common/upstream/cluster_manager_impl.cc
+++ b/source/common/upstream/cluster_manager_impl.cc
@@ -2232,7 +2232,7 @@ Http::ConnectionPool::InstancePtr ProdClusterManagerFactory::allocateConnPool(
       getOrigin(transport_socket_options, host);
   if (protocols.size() == 3 &&
       context_.runtime().snapshot().featureEnabled("upstream.use_http3", 100) &&
-      !transport_socket_options->http11ProxyInfo()) {
+      (!transport_socket_options || !transport_socket_options->http11ProxyInfo())) {
     ASSERT(contains(protocols,
                     {Http::Protocol::Http11, Http::Protocol::Http2, Http::Protocol::Http3}));
     ASSERT(alternate_protocol_options.has_value());
diff --git a/test/integration/BUILD b/test/integration/BUILD
index 7cdf00028f..fcd1dc69c2 100644
--- a/test/integration/BUILD
+++ b/test/integration/BUILD
@@ -53,6 +53,24 @@ envoy_cc_test_library(
     ],
 )
 
