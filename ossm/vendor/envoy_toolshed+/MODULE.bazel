http_archive(
    name = "hunspell_src",
    build_file = "//hunspell/private:hunspell.BUILD.bazel",
    sha256 = "9c650ace31d4d8cc1da925a9507c3de1d50f1a54857af2f72429f517d5d53467",
    strip_prefix = "hunspell-1.7.6",
    url = "https://github.com/hunspell/hunspell/releases/download/v1.7.6/hunspell-1.7.6.tar.gz",
)

http_archive(
    name = "dictionary_en",
    build_file = "//hunspell/private:dictionary_en.BUILD.bazel",
    sha256 = "160cba5e6c0230d43d70b0c929e498566ff2c3c4bcf840318d98ce28e31ee756",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/dictionary-en/-/dictionary-en-4.0.0.tgz",
)

sq_prebuilt_ext = use_extension("//pgp:extensions.bzl", "sq_prebuilt_extension")
sq_prebuilt_ext.setup()
use_repo(sq_prebuilt_ext, "sq_toolchains")

# Base sysroots shared by the LLVM and GCC toolchains.
sysroot_ext = use_extension("//sysroot:extensions.bzl", "sysroot_extension", dev_dependency = True)
sysroot_ext.setup()
use_repo(sysroot_ext, "sysroot_linux_amd64", "sysroot_linux_arm64")

# libstdc++13 sysroot variant, exercised by //sysroot/test. Not used by the
# toolchains: GCC supplies its own libstdc++ and must stay on the base sysroot.
sysroot_ext.setup(
    name_prefix = "libstdcxx",
    stdcc_version = "13",
)
use_repo(sysroot_ext, "libstdcxx_sysroot_linux_amd64", "libstdcxx_sysroot_linux_arm64")

macos_sysroot_test_repo = use_repo_rule("//sysroot:sysroot.bzl", "macos_sysroot")

macos_sysroot_test_repo(
    name = "sysroot_macos_empty",
    dev_dependency = True,
    version = "test",
)

macos_sysroot_build_ext = use_extension("//sysroot:extensions.bzl", "macos_sysroot_build_extension", dev_dependency = True)
use_repo(macos_sysroot_build_ext, "macos_sdk_pkg", "pkgutil_linux_amd64")

# Prebuilt wee8 repos plus the @wee8_source fallback used by //v8:wee8 on
# platforms with no prebuilt. Consumers opt in to a source build with
# `setup(source = "@v8//:wee8")`; toolshed does so only in its dev graph so v8
# stays a dev dependency.
wee8_prebuilt_ext = use_extension("//v8:extensions.bzl", "wee8_prebuilt_extension")
wee8_prebuilt_ext.setup()
use_repo(wee8_prebuilt_ext, "wee8_prebuilt_aarch64", "wee8_prebuilt_aarch64_libstdcxx", "wee8_prebuilt_x86_64", "wee8_prebuilt_x86_64_libstdcxx", "wee8_source")

wee8_source_ext = use_extension("//v8:extensions.bzl", "wee8_prebuilt_extension", dev_dependency = True)
wee8_source_ext.setup(source = "@v8//:wee8")

