# use_repo(glint_ext, "glint")

gcc = use_extension("//toolchains/gcc:extensions.bzl", "gcc_extension", dev_dependency = True)
gcc.toolchain(
    name = "gcc_linux_x86_64",
    arch = "x86_64",
    dwp = "@llvm_minimal_linux_x64//:bin/llvm-dwp",
    lld = "@llvm_minimal_linux_x64//:bin/lld",
    sysroot = "@sysroot_linux_amd64//sysroot",
)
gcc.toolchain(
    name = "gcc_linux_aarch64",
    arch = "aarch64",
    dwp = "@llvm_minimal_linux_x64//:bin/llvm-dwp",
    lld = "@llvm_minimal_linux_x64//:bin/lld",
    sysroot = "@sysroot_linux_arm64//sysroot",
)
use_repo(gcc, "gcc_host", "gcc_host_platform", "gcc_linux_aarch64", "gcc_linux_x86_64")

# This needs to be before llvm to win in transitions.
register_toolchains(
    "//toolchains/gcc:linux_x64_toolchain",
    "//toolchains/gcc:linux_arm64_toolchain",
    # The fallback, after the archives.
    "//toolchains/gcc:linux_host_toolchain",
    dev_dependency = True,
)

# Configure LLVM toolchain

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.cxx_cross_lib(
    name = "llvm_toolchain",
    label = "@libcxx_libs_aarch64",
    targets = ["linux-aarch64"],
)
llvm.cxx_cross_lib(
    name = "llvm_toolchain",
    label = "@libcxx_libs_x86_64",
    targets = ["linux-x86_64"],
)

# The base sysroot ships libgcc_s.so.1 (+ an unversioned libgcc_s.so ld script)
# but no libgcc.a/libgcc_eh.a or GCC crt objects. Use compiler-rt for builtins
# and crt files; keep libgcc_s as the (as-needed) fallback unwinder so
# libunwind=False still resolves _Unwind_* while libunwind=True leaves no
# libgcc_s NEEDED entry.
llvm.toolchain(
    name = "llvm_toolchain",
    extra_link_flags = {
        "linux-aarch64": [
            "-rtlib=compiler-rt",
            "-unwindlib=libgcc",
        ],
        "linux-x86_64": [
            "-rtlib=compiler-rt",
            "-unwindlib=libgcc",
        ],
    },
    llvm_version = "22.1.8",
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_minimal_linux_x64",
    targets = ["linux-x86_64"],
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_minimal_linux_arm64",
    targets = ["linux-aarch64"],
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_minimal_macos_arm64",
    targets = ["darwin-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_amd64//sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_arm64//sysroot",
    targets = ["linux-aarch64"],
)
llvm.extra_exec_compatible_with(
    name = "llvm_toolchain",
    constraints = ["//compile:llvm_worker"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

# Stub OpenPGP signer used by //pgp/test analysis tests. It is registered first
# in dev mode so those tests resolve the stub instead of the default `sq` signer.
register_toolchains(
    "//pgp/test:stub_toolchain",
    dev_dependency = True,
)

# Prebuilt sq toolchains are registered after the stub so dev-only analysis
# tests still resolve the stub first, and before the dev-only source fallback.
register_toolchains("@sq_toolchains//:all")

sq_source_ext = use_extension("//pgp:extensions.bzl", "sq_source_extension", dev_dependency = True)
sq_source_ext.setup(sq = "@sq//:sq_from_source")
use_repo(sq_source_ext, "envoy_toolshed_sq_source")

register_toolchains(
    "@envoy_toolshed_sq_source//:source_toolchain",
    dev_dependency = True,
)

# Prebuilt git toolchains are registered first so constrained matches win before
# the unconstrained source fallback.
register_toolchains("@git_toolchains//:all")

git_source_ext = use_extension("//git:extensions.bzl", "git_source_extension", dev_dependency = True)
git_source_ext.setup(
    cacert = "@cacert//file",
    git = "@git//:git",
    git_remote_http = "@git//:git-remote-http",
    ssl_lib = "@curl//:ssl_lib",
    templates = "@git//:templates",
)
use_repo(git_source_ext, "envoy_toolshed_git_source")

register_toolchains(
    "@envoy_toolshed_git_source//:source_toolchain",
    dev_dependency = True,
)

# Test-only toolchain over the host's git, exercising the hub's host fallback mechanism
# on this host (see //git/test:toolchain_host_test). Not registered: tests force it.
git_host_test = use_repo_rule("//git/test:host_repo.bzl", "git_host_test")

git_host_test(
    name = "envoy_toolshed_git_host_test",
    dev_dependency = True,
)

# Prebuilt hunspell toolchains first, so constrained matches win before the source fallback,
# which is registered for consumers too: platforms without a prebuilt build hunspell from source.
register_toolchains("@hunspell_toolchains//:all")

register_toolchains(
    "//hunspell/source:source_toolchain_linux",
    "//hunspell/source:source_toolchain_macos",
)

# pigz: the prebuilt toolchains, then (toolshed only) the source build, then a toolchain that
# fails, naming the platform without a pigz. Consumers get the prebuilts only: a consumer that
# wants pigz elsewhere registers its own source toolchain (see //pigz:README.md).
register_toolchains("@pigz_toolchains//:all")

register_toolchains(
    "//pigz/source:source_toolchain_linux",
    "//pigz/source:source_toolchain_macos",
    dev_dependency = True,
)

register_toolchains("//pigz:unavailable_toolchain")

libcxx_ext = use_extension("//compile:extensions.bzl", "libcxx_extension", dev_dependency = True)
use_repo(libcxx_ext, "llvm_libcxx_aarch64", "llvm_libcxx_x86_64")

libcxx_libs_ext = use_extension("//compile:extensions.bzl", "libcxx_libs_extension", dev_dependency = True)
libcxx_libs_ext.setup()
use_repo(libcxx_libs_ext, "libcxx_libs_aarch64", "libcxx_libs_x86_64")

# Set up raw LLVM tarball download repos needed to build //compile:llvm_minimal_* targets.
# These are dev_dependency only — consumers use the llvm_minimal_* http_archive repos instead.
llvm_minimal_build_ext = use_extension("//compile:extensions.bzl", "llvm_minimal_build_extension", dev_dependency = True)
use_repo(llvm_minimal_build_ext, "llvm_tarball_linux_arm64", "llvm_tarball_linux_x86_64", "llvm_tarball_macos_arm64")

llvm_minimal_ext = use_extension("//compile:extensions.bzl", "llvm_minimal_extension", dev_dependency = True)
llvm_minimal_ext.setup()
use_repo(llvm_minimal_ext, "llvm_minimal_linux_arm64", "llvm_minimal_linux_x64", "llvm_minimal_macos_arm64")

llvm_toolchain_alias_ext = use_extension("//compile:extensions.bzl", "llvm_toolchain_alias_extension", dev_dependency = True)
use_repo(llvm_toolchain_alias_ext, "llvm_toolchain_llvm")
