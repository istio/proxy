http_archive(
    name = "llvm_source",
    build_file_content = """filegroup(name = "all", srcs = glob(["**"]), visibility = ["//visibility:public"])""",
    dev_dependency = True,
    sha256 = "ad18b70e287954c3d62bc7e0b86e7b7af2adf87bcfce21c15fe717f101d7aace",
    strip_prefix = "llvm-project-llvmorg-22.1.8",
    url = "https://github.com/llvm/llvm-project/archive/llvmorg-22.1.8.tar.gz",
)

cert_epoch_ext = use_extension("//certs:extensions.bzl", "cert_epoch_extension")
use_repo(cert_epoch_ext, "cert_epoch")

git_prebuilt_ext = use_extension("//git:extensions.bzl", "git_prebuilt_extension")
git_prebuilt_ext.setup()
use_repo(git_prebuilt_ext, "cacert", "git_toolchains")

hunspell_prebuilt_ext = use_extension("//hunspell:extensions.bzl", "hunspell_prebuilt_extension")
