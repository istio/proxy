# Consumers configure their own grcov repository for coverage_report.
grcov_ext = use_extension("//coverage/grcov:extensions.bzl", "grcov_extension", dev_dependency = True)
grcov_ext.setup()
use_repo(grcov_ext, "grcov")

# Setup glint for code style linting - example for downstream consumers
