#############################################################################################
# deps: dev
#############################################################################################

bazel_dep(name = "curl", version = "8.11.0.bcr.4", dev_dependency = True)
bazel_dep(name = "git", version = "2.55.0", dev_dependency = True)

# Source pigz: the bins release (`//pigz/source:pigz_packages`) and toolshed's tests only.
# Keep in sync with VERSIONS["pigz"].
bazel_dep(name = "pigz", version = "2.8.bcr.3", dev_dependency = True)
bazel_dep(name = "zlib-ng", version = "2.3.3.bcr.2", dev_dependency = True)

# pigz against zlib-ng (zlib-compatible, faster at the same level) rather than zlib. The label is
# canonical: the patched module still depends on `zlib`, so `@zlib-ng` is not visible from it.
single_version_override(
    module_name = "pigz",
    patch_strip = 0,
    patches = ["//pigz/private:pigz-zlib-ng.patch"],
    version = "2.8.bcr.3",
)

bazel_dep(name = "protobuf", version = "35.1.bcr.envoy", dev_dependency = True, repo_name = "com_google_protobuf")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0", dev_dependency = True)
bazel_dep(name = "rules_jq", version = "0.0.0", dev_dependency = True)
bazel_dep(name = "sq", version = "1.4.0.envoy", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.9.1.envoy", dev_dependency = True)
bazel_dep(name = "v8", version = "14.6.202.10.envoy.1", dev_dependency = True)



