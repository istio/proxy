# toolchains
#############################################################################################

bazel_lib_toolchains = use_extension("@aspect_bazel_lib//lib:extensions.bzl", "toolchains")
bazel_lib_toolchains.jq(version = "1.7")
bazel_lib_toolchains.yq()
bazel_lib_toolchains.tar()
use_repo(bazel_lib_toolchains, "bsd_tar_toolchains", "jq", "jq_toolchains", "yq", "yq_toolchains")

buildifier_prebuilt = use_extension("@buildifier//:defs.bzl", "buildifier_prebuilt_deps_extension")
buildifier_prebuilt.toolchains()
use_repo(buildifier_prebuilt, "buildifier_prebuilt_toolchains")

PYTHON_VERSION_DEFAULT = "3.12"

PYTHON_VERSIONS = [
    "3.11",
    "3.12",
]

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

[
    python.toolchain(
        is_default = python_version == PYTHON_VERSION_DEFAULT,
        python_version = python_version,
    )
    for python_version in PYTHON_VERSIONS
]

use_repo(python, "python_3_11_host", "python_3_12_host")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

[
    pip.parse(
        hub_name = "website_pip3",
        python_version = python_version,
        requirements_lock = "//website:requirements.txt",
    )
    for python_version in PYTHON_VERSIONS
]

use_repo(pip, "website_pip3")

[
    pip.parse(
        hub_name = "cve_pip3",
        python_version = python_version,
        requirements_lock = "//dependency/cve:requirements_lock.txt",
    )
    for python_version in PYTHON_VERSIONS
]

use_repo(pip, "cve_pip3")

reachability_test_ext = use_extension("//dependency/test:reachability_test_extension.bzl", "reachability_test_extension", dev_dependency = True)
use_repo(reachability_test_ext, "apparent_excluded_repo", "apparent_excluded_transitive_repo")

arch_alias_ext = use_extension("//repository:extensions.bzl", "arch_alias_extension", dev_dependency = True)
arch_alias_ext.alias(
    name = "toolshed_arch_alias_smoke",
    aarch64 = "//platforms/rbe:linux_arm64",
    amd64 = "//platforms/rbe:linux_x64",
